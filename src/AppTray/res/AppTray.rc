#pragma code_page(65001)

#include "..\resource.h"
#include "..\..\AppTray.Core\Version.h"
#include <winres.h>

IDI_APPTRAY ICON "AppTray.ico"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION APPTRAY_VERSION_MAJOR, APPTRAY_VERSION_MINOR, APPTRAY_VERSION_PATCH, 0
	PRODUCTVERSION APPTRAY_VERSION_MAJOR, APPTRAY_VERSION_MINOR, APPTRAY_VERSION_PATCH, 0
	FILEFLAGSMASK 0x3fL
	FILEFLAGS 0x0L
	FILEOS VOS_NT_WINDOWS32
	FILETYPE VFT_APP
	FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "asb314"
			VALUE "FileDescription", "AppTray - tray launcher for portable apps"
			VALUE "FileVersion", APPTRAY_VERSION_TEXT
			VALUE "InternalName", "AppTray"
			VALUE "LegalCopyright", "Copyright (c) 2026 asb314. MIT License."
			VALUE "OriginalFilename", "AppTray.exe"
			VALUE "ProductName", "AppTray"
			VALUE "ProductVersion", APPTRAY_VERSION_TEXT
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
